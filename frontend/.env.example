# Logging configuration
# Levels: trace | debug | info | warn | error | silent
# Development default: debug (all messages visible)
# Production default: warn (only warnings and errors)
VITE_LOG_LEVEL=debug

# Live demo: link to a recording of the guided demo, shown as "Watch the demo"
# on the entry page. The button is hidden when this is unset.
# VITE_DEMO_RECORDING_URL=https://example.com/demo-video

# Live demo: base URL of the published docs site (the VitePress build of docs/).
# The guided tour links its "how this works" notes to pages under it, and the
# links are hidden when this is unset.
# VITE_DOCS_URL=https://example.com/docs/
