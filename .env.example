# Open Karaoke Studio Backend Environment Configuration
# Copy this file to .env and update the values for your environment

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:5123

# Database Configuration
DATABASE_URL=sqlite:///karaoke.db

# File Storage Paths
LIBRARY_DIR=/path/to/karaoke_library

# Redis/Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
# Development example:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# YouTube Music OAuth (for session playlist generation)
# Run: cd backend && source venv/bin/activate && ytmusicapi oauth
# Then set the path to the generated oauth.json file here
YTMUSIC_OAUTH_FILE=/path/to/ytmusic_oauth.json

# Music Metadata API Keys
# Discogs: free personal token from discogs.com/settings/developers (artist images)
DISCOGS_TOKEN=your-discogs-token-here
# Last.fm: free key from last.fm/api/account/create (artist biographies)
LASTFM_API_KEY=your-lastfm-api-key-here
# AcoustID: free key from acoustid.org/api/applications (audio fingerprinting)
ACOUSTID_API_KEY=your-acoustid-api-key-here

# Audio Processing Configuration
DEMUCS_MODEL=htdemucs_ft
MP3_BITRATE=320

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./backend/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=detailed

# Upload Configuration
# Max file upload size (200MB in bytes)
MAX_CONTENT_LENGTH=209715200

# Server Configuration
HOST=0.0.0.0
PORT=5123

# Flask Debug Settings (development only)
FLASK_DEBUG=true
FLASK_USE_RELOADER=true
