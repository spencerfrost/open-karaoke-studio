# Open Karaoke Studio — environment configuration
# Copy to .env in the project root and adjust for your machine.
# Used by the FastAPI backend (and loaded from repo root via backend/app/main.py).

# -----------------------------------------------------------------------------
# Application environment
# -----------------------------------------------------------------------------
# ENVIRONMENT is preferred; FLASK_ENV is still read for backward compatibility.
ENVIRONMENT=development
FLASK_ENV=development

# -----------------------------------------------------------------------------
# Authentication (required for stable logins across API restarts)
# -----------------------------------------------------------------------------
# If unset, a random key is generated each restart and all JWT sessions are invalidated.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Legacy app secret (still used by some config paths; set in production)
SECRET_KEY=your-secret-key-here

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5123

# CORS origins (comma-separated)
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------------------------------------------------
# Frontend (Vite — see also frontend/.env.example)
# -----------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:5123

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (local dev):
DATABASE_URL=sqlite:///karaoke.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://karaoke_user:karaoke_pass@localhost/karaoke

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Defaults to ./karaoke_library at project root if unset
LIBRARY_DIR=/path/to/karaoke_library

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# YouTube Music (session playlist generation)
# -----------------------------------------------------------------------------
# Run: cd backend && source venv/bin/activate && ytmusicapi oauth
# Then point to the generated oauth.json:
YTMUSIC_OAUTH_FILE=/path/to/ytmusic_oauth.json

# -----------------------------------------------------------------------------
# Music metadata API keys (optional)
# -----------------------------------------------------------------------------
# Discogs: discogs.com/settings/developers — artist images
DISCOGS_TOKEN=your-discogs-token-here
# Last.fm: last.fm/api/account/create — artist biographies
LASTFM_API_KEY=your-lastfm-api-key-here
# AcoustID: acoustid.org/api/applications — audio fingerprinting
ACOUSTID_API_KEY=your-acoustid-api-key-here

# -----------------------------------------------------------------------------
# Audio processing
# -----------------------------------------------------------------------------
DEMUCS_MODEL=htdemucs_ft
MP3_BITRATE=320

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./backend/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=detailed

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
MAX_CONTENT_LENGTH=209715200
