# Open Karaoke Studio — environment configuration
# Copy to .env in the project root and fill it in for development.
#
# The dev API and Celery read this file directly. Docker (docker-compose.yml)
# reads it too, but only for the secrets, keys and the few settings it passes
# through; the production addresses (database, Redis, library) are set in
# docker-compose.yml itself, so the dev values here never reach the containers.

# -----------------------------------------------------------------------------
# Environment: development | production
# -----------------------------------------------------------------------------
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Signs logins. If unset, a random key is made on each restart and everyone is
# signed out.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Signs the tag that marks which session a job belongs to. Required in
# production.
SECRET_KEY=change-me-to-another-long-random-string

# First admin. When both are set and the database has no admin yet, the API
# creates this account on startup (password at least 8 characters). Ignored once
# any admin exists, so change the password later with:
#   python scripts/manage_users.py reset-password --username <name> --password <new>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-a-long-password

# Docker: uncomment to give the Celery worker an NVIDIA GPU (needs the NVIDIA
# Container Toolkit). Without it the worker separates songs on the CPU.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Docker's Postgres. docker-compose.yml defaults to karaoke / karaoke_user /
# karaoke_pass when these are unset.
# POSTGRES_DB=karaoke
# POSTGRES_USER=karaoke_user
# POSTGRES_PASSWORD=change-me

# Docker's private network. Change both if 172.30.250.0/24 clashes with another
# Docker network on this machine ("Pool overlaps with other one on this address
# space"). KARAOKE_PROXY_IP is the bundled nginx's address and must sit inside
# the subnet. A changed subnet needs `docker compose down`, then `up`.
# KARAOKE_SUBNET=172.30.250.0/24
# KARAOKE_PROXY_IP=172.30.250.10

# Docker: most CPU cores and memory the Celery worker may use. Separation peaks
# at several GB; lower these on a small machine, at the cost of speed.
# CELERY_CPU_LIMIT=4
# CELERY_MEMORY_LIMIT=12G

# -----------------------------------------------------------------------------
# Where things are (development)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://karaoke_user:karaoke_pass@localhost/karaoke

# Song files. Defaults to ./karaoke_library at the project root.
# LIBRARY_DIR=/path/to/karaoke_library

CELERY_BROKER_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Web access
# -----------------------------------------------------------------------------
# Origins allowed to call the API (comma-separated). Production must set
# something; there the app and API share one origin through nginx, so the dev
# value works.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proxies whose X-Forwarded-For uvicorn trusts (comma-separated IPs/CIDRs).
# Behind a reverse proxy this is how the API sees each visitor's real IP, which
# per-IP rate limits (login, the live demo) key on. docker-compose.yml defaults
# it to the bundled nginx container's pinned address (KARAOKE_PROXY_IP); add your
# own reverse proxy's address here if one sits in front of nginx. uvicorn's own
# default is 127.0.0.1. Never trust a range direct callers can come from.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Where the Vite dev server sends /api and /ws. Development only.
VITE_BACKEND_URL=http://localhost:5123

# Live demo (Docker build args; see docs/demo-accounts.md). Hidden when unset.
# VITE_DEMO_RECORDING_URL=https://example.com/demo-video
# VITE_DOCS_URL=https://example.com/docs/

# -----------------------------------------------------------------------------
# Music metadata API keys (optional)
# -----------------------------------------------------------------------------
# Discogs: discogs.com/settings/developers — artist images
DISCOGS_TOKEN=
# AcoustID: acoustid.org/api/applications — audio fingerprinting
ACOUSTID_API_KEY=

# -----------------------------------------------------------------------------
# YouTube cookies (optional — for age-restricted / login-gated videos)
# -----------------------------------------------------------------------------
# Netscape-format cookie jar. Export with a browser extension ("Get
# cookies.txt LOCALLY") from a logged-in youtube.com tab. Use a throwaway
# Google account — this file is a full account credential. Leave unset to
# disable (default); downloads of age-restricted videos will keep failing
# with "Sign in to confirm your age" until this is set.
# Cookies expire — re-export when age-restricted downloads start failing
# again. Docker: drop the file at ./secrets/yt-cookies.txt (mounted
# read-only into the api and celery containers).
# YTDLP_COOKIES_FILE=/path/to/yt-cookies.txt

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# How much the console shows (tmux panes, docker logs): DEBUG, INFO, WARNING,
# ERROR. The log files always keep INFO. Unset: INFO in development, WARNING
# in production.
# LOG_LEVEL=INFO
